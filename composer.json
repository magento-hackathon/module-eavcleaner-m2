{
    "name": "magento-hackathon/module-eavcleaner-m2",
    "description": "Purpose of this project is to check for different flaws that can occur due to EAV and provide cleanup functions.",
    "require": {
        "php": "~7.3||~8.0",
        "magento/magento2-base": "~2.3"
    },
    "license": "MIT",
    "type": "magento2-module",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hackathon\\EAVCleaner\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
